# Development Environment Configuration
# Raydium Stream Service

# Network Configuration
HTTP_PORT=8086
BIND_ADDRESS=0.0.0.0:8086

# Kafka Configuration
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=raydium-transactions

# Geyser Configuration
GEYSER_URL=localhost:8899
GEYSER_ACCESS_TOKEN=your_dev_token_here

# Database Configuration
DATABASE_URL=postgresql://mevana_user:mevana_password@localhost:5432/mevana_metrics

# Logging
RUST_LOG=info
