# Builder stage: build only the dex-stream-universal crate and its local deps
FROM rust:1.88-slim as builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

# Copy only the crate(s) we need to compile, not the whole workspace
COPY crates/shared-core /usr/src/app/crates/shared-core
COPY crates/dex-stream-universal /usr/src/app/crates/dex-stream-universal

# For sqlx (offline macros) and to standardize target dir
ENV DATABASE_URL=postgresql://user:pass@localhost/db
ENV CARGO_TARGET_DIR=/usr/src/app/target

# Build the dex-stream-universal binary using the crate manifest
RUN cargo build --release --manifest-path crates/dex-stream-universal/Cargo.toml

# Runtime stage: minimal dependencies for running the binary
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    librdkafka1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/src/app/target/release/dex-stream-universal /app/dex-stream-universal

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://:8080/health || exit 1

CMD ["./dex-stream-universal"]


