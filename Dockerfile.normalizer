FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY target/debug/normalizer-service /usr/local/bin/normalizer-service
RUN chmod +x /usr/local/bin/normalizer-service

EXPOSE 8085

ENTRYPOINT ["/usr/local/bin/normalizer-service"]