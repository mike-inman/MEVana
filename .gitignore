# Build artifacts
/target/
/**/target/
crates/*/target/
crates/**/target/
**/*.so
**/*.dylib
**/*.dll
**/*.a
**/*.lib
**/*.exe

# Debug files
**/*.pdb
**/*.dSYM/
**/*.dwarf

# Logs and runtime state
logs/
*.log
*.pid
pids/
backups/
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db

# Temporary files
tmp/
*.tmp
*.bak
*.backup
*.old
*.orig
*~

# Deployment archives
*.tgz
*.tar.gz
infra.tgz

# Environment files
.env
.env*
.env.*
*.env
*.env.*
!.env.example
!*.env.example
!*.env.sample
infra/docker/.env.docker

# IDE files
.vscode/
.idea/
.claude/
.cursor/
*.swp
*.swo
*.sublime-*
*.iml

# OS files
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# Python artifacts (if any)
__pycache__/
*.py[cod]
*$py.class
*.so

# Node artifacts (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secret and session material
*.pem
*.key
*.p12
*.pfx
*keypair*.json
id.json
cookies.txt
*cookie*
*session*
wallet*.json
config/keys/
infrastructure/keys/

# Cargo lock files (optional - remove if you want to commit them)
# Cargo.lock

# IMPORTANT: Track all source files by default
# Rust source files
!**/*.rs
!**/Cargo.toml
!**/Cargo.lock

# Documentation
!**/*.md
!**/README*
!**/LICENSE*
!**/CHANGELOG*

# Configuration files
!**/*.yaml
!**/*.yml
!**/*.toml
!**/*.json
!**/*.jsonl

# Scripts
!**/*.sh
!**/*.bash

# Docker files
!**/Dockerfile*
!**/docker-compose*.yml

# IDL files
!**/*.idl
!**/idls/**

# Test fixtures and data
!**/fixtures/**
!**/test_data/**

# But still ignore backup files even with these extensions
*.rs.bak
*.toml.bak
*.yaml.bak
*.yml.bak
*.json.bak
