# Build artifacts
/target/
/**/target/
crates/*/target/
crates/**/target/
**/*.so
**/*.dylib
**/*.dll
**/*.a
**/*.lib
**/*.exe

# Debug files
**/*.pdb
**/*.dSYM/
**/*.dwarf

# Logs
logs/
*.log

# Temporary files
tmp/
*.tmp
*.bak
*.backup
*.old
*.orig
*~

# Environment files
.env
.env*
infra/docker/.env.docker

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.sublime-*
*.iml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python artifacts (if any)
__pycache__/
*.py[cod]
*$py.class
*.so

# Node artifacts (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files
*.sqlite
*.sqlite3
*.db

# Cargo lock files (optional - remove if you want to commit them)
# Cargo.lock

# IMPORTANT: Track all source files by default
# Rust source files
!**/*.rs
!**/Cargo.toml
!**/Cargo.lock

# Documentation
!**/*.md
!**/README*
!**/LICENSE*
!**/CHANGELOG*

# Configuration files
!**/*.yaml
!**/*.yml
!**/*.toml
!**/*.json
!**/*.jsonl

# Scripts
!**/*.sh
!**/*.bash

# Docker files
!**/Dockerfile*
!**/docker-compose*.yml

# IDL files
!**/*.idl
!**/idls/**

# Test fixtures and data
!**/fixtures/**
!**/test_data/**

# But still ignore backup files even with these extensions
*.rs.bak
*.toml.bak
*.yaml.bak
*.yml.bak
*.json.bak
config/keys/
