    {
      "id": 8,
      "title": "Missing state by pool — Diagnostic probe: raw input amounts, not chained route amounts",
      "type": "table",
      "description": "Each row is a raw input amount probe for one pool direction. Missing reason cells have no separate outcome row; they are not inferred as zero.",
      "datasource": {
        "type": "postgres",
        "uid": "research-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "research-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH directions AS ( SELECT pool_id,input_symbol,output_symbol,probe_input_atoms,max(attempts) AS attempts, sum(CASE WHEN outcome='insufficient_state' THEN outcome_count ELSE 0 END)::bigint AS insufficient_state, sum(CASE WHEN outcome='tick_array_absent' THEN outcome_count ELSE 0 END)::bigint AS tick_array_absent, sum(CASE WHEN outcome='state_gap' THEN outcome_count ELSE 0 END)::bigint AS state_gap FROM research.v_probe_evidence WHERE result_id=${experiment:sqlstring} GROUP BY pool_id,input_symbol,output_symbol,probe_input_atoms ) SELECT pool_id AS \"Pool\", input_symbol || ' → ' || output_symbol AS \"Direction\", to_char(attempts,'FM999,999,999,999') AS \"Attempts\", insufficient_state AS \"insufficient_state\", tick_array_absent AS \"tick_array_absent\", state_gap AS \"state_gap\", array_to_string(ARRAY(SELECT to_char(atom,'FM999,999,999,999') FROM unnest(probe_input_atoms) atom), ', ') AS \"Probe input atoms\" FROM directions UNION ALL SELECT 'Not measured for this experiment', NULL::text, NULL::text, NULL::bigint, NULL::bigint, NULL::bigint, NULL::text WHERE NOT EXISTS (SELECT 1 FROM directions) ORDER BY \"Pool\", \"Direction\""
