    {
      "id": 5,
      "title": "Where candidates went: rejection counts",
      "type": "barchart",
      "description": "One selected experiment. Rejection counts are grouped by policy and reason.",
      "datasource": {
        "type": "postgres",
        "uid": "research-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "research-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT policy_kind AS \"Policy\", max(rejected_count) FILTER (WHERE reason_code='below_threshold') AS below_threshold, max(rejected_count) FILTER (WHERE reason_code='insufficient_state') AS insufficient_state, max(rejected_count) FILTER (WHERE reason_code='tick_array_absent') AS tick_array_absent, max(rejected_count) FILTER (WHERE reason_code='state_gap') AS state_gap FROM research.policy_rejections WHERE result_id=${experiment:sqlstring} GROUP BY policy_kind ORDER BY policy_kind"
