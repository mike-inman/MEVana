{
  "id": null,
  "title": "🌊 MEVana Geyser Stream Activity Monitor",
  "tags": ["mevana", "geyser", "streaming", "real-time"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h"]
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "🔥 Live Geyser Stream Activity",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(normalizer_transactions_processed[1m]) * 60",
          "legendFormat": "Transactions/min",
          "refId": "A"
        },
        {
          "expr": "rate(normalizer_swaps_extracted[1m]) * 60", 
          "legendFormat": "Swaps/min",
          "refId": "B"
        },
        {
          "expr": "discovery_programs_discovered_total",
          "legendFormat": "Programs Discovered",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 10},
              {"color": "green", "value": 100}
            ]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Transactions/min"},
            "properties": [
              {"id": "color", "value": {"mode": "continuous-GrYlRd"}},
              {"id": "unit", "value": "reqps"}
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "📊 Kafka Topic Activity (Geyser Data Flow)",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(normalizer_transactions_processed[5m])",
          "legendFormat": "DEX Transactions Processed",
          "refId": "A"
        },
        {
          "expr": "rate(normalizer_swaps_extracted[5m])",
          "legendFormat": "Swaps Extracted", 
          "refId": "B"
        },
        {
          "expr": "rate(edge_assembler_edges_processed[5m])",
          "legendFormat": "Edges Assembled",
          "refId": "C"
        }
      ],
      "yAxes": [
        {"label": "Messages per second", "min": 0}
      ],
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "points": true,
      "pointradius": 2,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
    },
    {
      "id": 3,
      "title": "🎯 Data Pipeline Health Status",
      "type": "table",
      "targets": [
        {
          "expr": "up{job=~\"discovery-service|normalizer-service|edge-assembler\"}",
          "legendFormat": "{{job}} - {{instance}}",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true},
            "renameByName": {
              "job": "Service",
              "instance": "Endpoint",
              "Value": "Status"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {"id": "custom.displayMode", "value": "color-background"},
              {
                "id": "mappings",
                "value": [
                  {"options": {"0": {"text": "🔴 DOWN", "color": "red"}}, "type": "value"},
                  {"options": {"1": {"text": "🟢 UP", "color": "green"}}, "type": "value"}
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 16}
    },
    {
      "id": 4,
      "title": "⚡ Real-Time Stream Performance",
      "type": "gauge",
      "targets": [
        {
          "expr": "rate(normalizer_transactions_processed[1m]) * 60",
          "legendFormat": "Live Transaction Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 50},
              {"color": "green", "value": 200},
              {"color": "blue", "value": 500}
            ]
          },
          "unit": "reqps",
          "min": 0,
          "max": 1000
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22}
    },
    {
      "id": 5,
      "title": "🌊 Geyser Connection Status",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(up{job=~\".*geyser.*|hotpath.*\"})",
          "legendFormat": "Geyser Services Online",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Real-time monitoring of Geyser stream activity and MEVana data pipeline performance. Shows live transaction processing rates, Kafka message throughput, and service health.",
  "gnetId": null,
  "version": 1
}