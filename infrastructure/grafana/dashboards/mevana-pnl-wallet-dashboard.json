{
  "id": null,
  "title": "MEVana P&L & Wallet Management",
  "tags": ["mevana", "pnl", "profit", "wallets", "trading", "finance"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "💰 Daily P&L Overview",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(arb_profit_captured_total[24h])",
          "legendFormat": "24h Profit (SOL)",
          "refId": "A"
        },
        {
          "expr": "increase(arb_profit_captured_total[1h])",
          "legendFormat": "1h Profit (SOL)",
          "refId": "B"
        },
        {
          "expr": "arb_total_pnl_sol",
          "legendFormat": "Total P&L (SOL)",
          "refId": "C"
        },
        {
          "expr": "arb_profit_capture_rate",
          "legendFormat": "Success Rate (%)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": -1},
              {"color": "yellow", "value": 0},
              {"color": "green", "value": 0.1}
            ]
          },
          "unit": "short",
          "decimals": 4
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Success Rate (%)"},
            "properties": [{"id": "unit", "value": "percent"}]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "🏦 Multi-Tier Wallet Balances",
      "type": "stat",
      "targets": [
        {
          "expr": "wallet_balance_sol{wallet_type=\"hot\"}",
          "legendFormat": "Hot Wallet {{wallet_id}}",
          "refId": "A"
        },
        {
          "expr": "wallet_balance_sol{wallet_type=\"warm\"}",
          "legendFormat": "Warm Wallet {{wallet_id}}",
          "refId": "B"
        },
        {
          "expr": "wallet_balance_sol{wallet_type=\"cold\"}",
          "legendFormat": "Cold Wallet {{wallet_id}}",
          "refId": "C"
        },
        {
          "expr": "sum(wallet_balance_sol)",
          "legendFormat": "Total Balance (SOL)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 10}
            ]
          },
          "unit": "short",
          "decimals": 6
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 3,
      "title": "⚠️ Wallet Risk Monitoring",
      "type": "gauge",
      "targets": [
        {
          "expr": "wallet_utilization_percent{wallet_type=\"hot\"}",
          "legendFormat": "Hot Wallet Utilization",
          "refId": "A"
        },
        {
          "expr": "wallet_daily_loss_percent",
          "legendFormat": "Daily Loss %",
          "refId": "B"
        },
        {
          "expr": "wallet_exposure_risk_score",
          "legendFormat": "Risk Score",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 80}
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 4,
      "title": "📈 Cumulative P&L Trend",
      "type": "graph",
      "targets": [
        {
          "expr": "arb_total_pnl_sol",
          "legendFormat": "Total P&L (SOL)",
          "refId": "A"
        },
        {
          "expr": "arb_profit_captured_total",
          "legendFormat": "Cumulative Profit (SOL)",
          "refId": "B"
        },
        {
          "expr": "arb_loss_total_sol",
          "legendFormat": "Cumulative Losses (SOL)",
          "refId": "C"
        }
      ],
      "yAxes": [
        {"label": "SOL", "min": null}
      ],
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "points": false,
      "pointradius": 2,
      "bars": false,
      "stack": false,
      "percentage": false,
      "legend": {
        "avg": false,
        "current": true,
        "max": true,
        "min": true,
        "show": true,
        "total": false,
        "values": true
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
    },
    {
      "id": 5,
      "title": "💸 Wallet Balance History",
      "type": "graph",
      "targets": [
        {
          "expr": "wallet_balance_sol{wallet_type=\"hot\"}",
          "legendFormat": "Hot Wallet {{wallet_id}}",
          "refId": "A"
        },
        {
          "expr": "wallet_balance_sol{wallet_type=\"warm\"}",
          "legendFormat": "Warm Wallet {{wallet_id}}",
          "refId": "B"
        },
        {
          "expr": "wallet_balance_sol{wallet_type=\"cold\"}",
          "legendFormat": "Cold Wallet {{wallet_id}}",
          "refId": "C"
        }
      ],
      "yAxes": [
        {"label": "SOL Balance", "min": 0}
      ],
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "points": false,
      "pointradius": 2,
      "bars": false,
      "stack": true,
      "percentage": false,
      "legend": {
        "avg": true,
        "current": true,
        "max": true,
        "min": true,
        "show": true,
        "total": true,
        "values": true
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
    },
    {
      "id": 6,
      "title": "🎯 Trading Performance Metrics",
      "type": "table",
      "targets": [
        {
          "expr": "arb_trades_executed_total",
          "legendFormat": "Total Trades",
          "refId": "A",
          "format": "table"
        },
        {
          "expr": "arb_execution_success_rate",
          "legendFormat": "Success Rate",
          "refId": "B",
          "format": "table"
        },
        {
          "expr": "arb_avg_profit_per_trade_sol",
          "legendFormat": "Avg Profit/Trade (SOL)",
          "refId": "C",
          "format": "table"
        },
        {
          "expr": "arb_max_drawdown_percent",
          "legendFormat": "Max Drawdown %",
          "refId": "D",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true},
            "renameByName": {
              "Value #A": "Total Trades",
              "Value #B": "Success Rate",
              "Value #C": "Avg Profit/Trade",
              "Value #D": "Max Drawdown %"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Success Rate"},
            "properties": [{"id": "unit", "value": "percentunit"}]
          },
          {
            "matcher": {"id": "byName", "options": "Max Drawdown %"},
            "properties": [{"id": "unit", "value": "percent"}]
          }
        ]
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 32}
    },
    {
      "id": 7,
      "title": "🔥 Real-Time Trading Activity",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(arb_trades_executed_total[5m]) * 60",
          "legendFormat": "Trades per Minute",
          "refId": "A"
        },
        {
          "expr": "rate(arb_opportunities_detected_total[5m]) * 60",
          "legendFormat": "Opportunities per Minute",
          "refId": "B"
        },
        {
          "expr": "rate(arb_profit_captured_total[5m]) * 60",
          "legendFormat": "Profit Rate (SOL/min)",
          "refId": "C"
        }
      ],
      "yAxes": [
        {"label": "Rate per minute", "min": 0}
      ],
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "points": true,
      "pointradius": 2,
      "bars": false,
      "stack": false,
      "percentage": false,
      "legend": {
        "avg": true,
        "current": true,
        "max": true,
        "min": false,
        "show": true,
        "total": false,
        "values": true
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 38}
    },
    {
      "id": 8,
      "title": "🏆 Top Performing DEX Venues",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (dex_venue) (arb_profit_by_venue_sol)",
          "legendFormat": "{{dex_venue}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "pieType": "pie",
        "tooltip": {"mode": "single"},
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 46}
    },
    {
      "id": 9,
      "title": "⚡ Execution Latency & Slippage",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(arb_execution_latency_ms_bucket[5m]))",
          "legendFormat": "p50 Execution Latency (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(arb_execution_latency_ms_bucket[5m]))",
          "legendFormat": "p95 Execution Latency (ms)",
          "refId": "B"
        },
        {
          "expr": "arb_avg_slippage_bps",
          "legendFormat": "Average Slippage (bps)",
          "refId": "C"
        }
      ],
      "yAxes": [
        {"label": "Milliseconds / Basis Points", "min": 0}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 46}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "wallet_type",
        "type": "query",
        "query": "label_values(wallet_balance_sol, wallet_type)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "dex_venue",
        "type": "query", 
        "query": "label_values(arb_profit_by_venue_sol, dex_venue)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": "prometheus",
        "enable": true,
        "expr": "changes(arb_total_pnl_sol[1m]) < -0.1",
        "iconColor": "red",
        "name": "Significant Loss Events",
        "titleFormat": "Loss Alert",
        "textFormat": "P&L dropped by {{$value}} SOL"
      }
    ]
  },
  "description": "Comprehensive P&L and wallet balance monitoring for MEVana trading operations. Tracks profitability, wallet security, risk metrics, and trading performance across multiple venues.",
  "gnetId": null,
  "version": 1
}