{
  "id": null,
  "title": "MEVana Arb Engine Adaptive Dashboard",
  "tags": ["mevana", "arb", "adaptive"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Adaptive Multiplier",
      "type": "timeseries",
      "datasource": null,
      "targets": [ { "expr": "arb_adaptive_multiplier" } ],
      "fieldConfig": { "defaults": { "unit": "none", "color": {"mode": "palette-classic"} } },
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Size Utilization (bps distribution)",
      "type": "heatmap",
      "targets": [ { "expr": "sum(rate(arb_size_utilization_bps_bucket[5m])) by (le)" } ],
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 0},
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3,
      "title": "Depth Adjustment Factor (bps distribution)",
      "type": "heatmap",
      "targets": [ { "expr": "sum(rate(arb_depth_factor_bps_bucket[5m])) by (le)" } ],
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 0},
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "title": "Signals Emitted (rate)",
      "type": "timeseries",
      "targets": [ { "expr": "rate(arb_signals_emitted_total[1m])" } ],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 7}
    },
    {
      "id": 5,
      "title": "Profit BPS (histogram rate)",
      "type": "heatmap",
      "targets": [ { "expr": "sum(rate(arb_profit_bps_bucket[5m])) by (le)" } ],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 7}
    },
    {
      "id": 6,
      "title": "Median Profit BPS (derived)",
      "type": "stat",
      "targets": [ { "expr": "histogram_quantile(0.5, sum(rate(arb_profit_bps_bucket[5m])) by (le))" } ],
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 7}
    },
    {
      "id": 7,
      "title": "Adaptive Mode Snapshot",
      "type": "stat",
      "targets": [ { "expr": "arb_adaptive_multiplier" } ],
      "fieldConfig": {"defaults": {"unit": "none"}},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 7}
    },
    {
      "id": 8,
      "title": "Error Ratio / Circuit",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(arb_edge_process_errors_total[5m])", "legendFormat": "process_err_rate" },
        { "expr": "rate(arb_edge_decode_errors_total[5m])", "legendFormat": "decode_err_rate" },
        { "expr": "arb_circuit_open", "legendFormat": "circuit_open" }
      ],
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 13}
    },
    {
      "id": 9,
      "title": "Staleness (ms)",
      "type": "timeseries",
      "targets": [ { "expr": "arb_edge_staleness_ms" } ],
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 13}
    },
    {
      "id": 10,
      "title": "Depth Impact BPS (Current Setting)",
      "type": "stat",
      "targets": [ { "expr": "arb_depth_impact_bps_setting" } ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 19}
    }
  ]
}
