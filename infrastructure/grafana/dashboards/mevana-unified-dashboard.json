{
  "id": null,
  "title": "🎯 MEVana Unified Dashboard - System Health & Trading Performance",
  "tags": ["mevana", "unified", "health", "trading", "real-time"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h"]
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "🚀 MEVana Multi-Stream System Health",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=~\"hotpath-arb-engine-stream.*\"}",
          "legendFormat": "Stream {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          },
          "unit": "short",
          "mappings": [
            {"options": {"0": {"text": "DOWN"}}, "type": "value"},
            {"options": {"1": {"text": "UP"}}, "type": "value"}
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "⚡ Real-Time Geyser Stream Performance",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(multi_geyser_stream_messages_total[1m]) * 60",
          "legendFormat": "Stream {{stream_id}} - Messages/min",
          "refId": "A"
        },
        {
          "expr": "rate(multi_geyser_stream_parsed_total[1m]) * 60",
          "legendFormat": "Stream {{stream_id}} - Parsed/min",
          "refId": "B"
        }
      ],
      "yAxes": [
        {"label": "Messages per Minute", "min": 0}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
    },
    {
      "id": 3,
      "title": "🎯 Arbitrage Detection Performance",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(arb_signals_emitted_total[1m]) * 60",
          "legendFormat": "Opportunities/min",
          "refId": "A"
        },
        {
          "expr": "rate(arb_signals_executed_total[1m]) * 60",
          "legendFormat": "Executed/min",
          "refId": "B"
        },
        {
          "expr": "rate(arb_signals_profitable_total[1m]) * 60",
          "legendFormat": "Profitable/min",
          "refId": "C"
        }
      ],
      "yAxes": [
        {"label": "Signals per Minute", "min": 0}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
    },
    {
      "id": 4,
      "title": "💰 Trading Performance Metrics",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(arb_signals_profitable_total[5m])) * 60 * 5",
          "legendFormat": "Profitable Signals (5min)",
          "refId": "A"
        },
        {
          "expr": "sum(arb_total_profit_usd)",
          "legendFormat": "Total Profit (USD)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, rate(arb_execution_latency_ms_bucket[5m]))",
          "legendFormat": "95th Percentile Latency (ms)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 10}
            ]
          },
          "unit": "short",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 14}
    },
    {
      "id": 5,
      "title": "🌊 Stream Latency Analysis",
      "type": "heatmap",
      "targets": [
        {
          "expr": "rate(multi_geyser_stream_latency_ms_bucket[1m])",
          "legendFormat": "{{le}}ms",
          "refId": "A"
        }
      ],
      "heatmap": {
        "yAxis": {
          "unit": "ms",
          "min": 0,
          "max": 100
        },
        "colorMode": "spectrum"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}
    },
    {
      "id": 6,
      "title": "📊 DEX Venue Performance",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(arb_venue_opportunities_total[1m]) * 60",
          "legendFormat": "{{venue}} - Opportunities/min",
          "refId": "A"
        }
      ],
      "yAxes": [
        {"label": "Opportunities per Minute", "min": 0}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}
    },
    {
      "id": 7,
      "title": "🔧 System Resource Usage",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "Stream {{stream_id}} - CPU %",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "Stream {{stream_id}} - Memory (MB)",
          "refId": "B"
        }
      ],
      "yAxes": [
        {"label": "CPU %", "min": 0, "max": 100},
        {"label": "Memory (MB)", "min": 0}
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28}
    },
    {
      "id": 8,
      "title": "🚨 Critical Alerts & Status",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=~\"hotpath-arb-engine-stream.*\"} == 0",
          "legendFormat": "Stream Down",
          "refId": "A"
        },
        {
          "expr": "rate(multi_geyser_stream_messages_total[5m]) == 0",
          "legendFormat": "No Data Flow",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(arb_execution_latency_ms_bucket[5m])) > 100",
          "legendFormat": "High Latency",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short",
          "mappings": [
            {"options": {"0": {"text": "OK"}}, "type": "value"},
            {"options": {"1": {"text": "ALERT"}}, "type": "value"}
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 36}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "stream_id",
        "type": "query",
        "query": "label_values(multi_geyser_stream_messages_total, stream_id)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Unified MEVana dashboard combining system health monitoring with real-time trading performance metrics. Shows multi-stream Geyser performance, arbitrage detection, execution latency, and profit tracking. Critical for monitoring the $200/month Shyft investment and ensuring ultra-low latency arbitrage detection.",
  "gnetId": null,
  "version": 1
}
