{
  "id": null,
  "title": "🌊 Raw Geyser Flow by DEX (Pre-Throttling)",
  "tags": ["mevana", "geyser", "raw", "dex", "unfiltered"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h"]
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "🔥 Raw Geyser Flow Rates by DEX (No Throttling)",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(multi_geyser_dex_messages_total{dex=\"jupiter-v6\"}[1m]) * 60",
          "legendFormat": "Jupiter V6",
          "refId": "A"
        },
        {
          "expr": "rate(multi_geyser_dex_messages_total{dex=\"raydium-clmm\"}[1m]) * 60",
          "legendFormat": "Raydium CLMM",
          "refId": "B"
        },
        {
          "expr": "rate(multi_geyser_dex_messages_total{dex=\"phoenix-clob\"}[1m]) * 60",
          "legendFormat": "Phoenix CLOB",
          "refId": "C"
        },
        {
          "expr": "rate(multi_geyser_dex_messages_total{dex=\"whirlpool\"}[1m]) * 60",
          "legendFormat": "Whirlpool",
          "refId": "D"
        },
        {
          "expr": "rate(multi_geyser_dex_messages_total{dex=\"raydium-amm\"}[1m]) * 60",
          "legendFormat": "Raydium AMM",
          "refId": "E"
        },
        {
          "expr": "rate(multi_geyser_dex_messages_total{dex=\"meteora-dlmm\"}[1m]) * 60",
          "legendFormat": "Meteora DLMM",
          "refId": "F"
        }
      ],
      "yAxes": [
        {
          "label": "Messages per minute",
          "min": 0
        }
      ],
      "lines": true,
      "fill": 2,
      "linewidth": 2,
      "points": true,
      "pointradius": 3,
      "tooltip": {
        "shared": true,
        "sort": 2,
        "value_type": "individual"
      },
      "legend": {
        "show": true,
        "values": true,
        "current": true,
        "alignAsTable": true,
        "rightSide": false
      },
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "📊 Raw DEX Message Totals (Cumulative)",
      "type": "stat",
      "targets": [
        {
          "expr": "multi_geyser_dex_messages_total{dex=\"jupiter-v6\"}",
          "legendFormat": "Jupiter V6",
          "refId": "A"
        },
        {
          "expr": "multi_geyser_dex_messages_total{dex=\"raydium-clmm\"}",
          "legendFormat": "Raydium CLMM",
          "refId": "B"
        },
        {
          "expr": "multi_geyser_dex_messages_total{dex=\"phoenix-clob\"}",
          "legendFormat": "Phoenix CLOB",
          "refId": "C"
        },
        {
          "expr": "multi_geyser_dex_messages_total{dex=\"whirlpool\"}",
          "legendFormat": "Whirlpool",
          "refId": "D"
        },
        {
          "expr": "multi_geyser_dex_messages_total{dex=\"raydium-amm\"}",
          "legendFormat": "Raydium AMM",
          "refId": "E"
        },
        {
          "expr": "multi_geyser_dex_messages_total{dex=\"meteora-dlmm\"}",
          "legendFormat": "Meteora DLMM",
          "refId": "F"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 50},
              {"color": "green", "value": 200},
              {"color": "blue", "value": 500}
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 10}
    },
    {
      "id": 3,
      "title": "⚡ Stream Health Status (Raw Geyser Connections)",
      "type": "table",
      "targets": [
        {
          "expr": "multi_geyser_stream_messages_total",
          "legendFormat": "Stream {{stream_id}}",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true},
            "renameByName": {
              "stream_id": "Stream ID",
              "Value": "Total Messages"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Total Messages"},
            "properties": [
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "color", "value": {"mode": "continuous-GrYlRd"}}
            ]
          }
        ]
      },
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16}
    },
    {
      "id": 4,
      "title": "🎯 Pipeline Health Summary",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(multi_geyser_dex_messages_total[1m])) * 60",
          "legendFormat": "Total Raw Flow/min",
          "refId": "A"
        },
        {
          "expr": "count(multi_geyser_dex_messages_total > 0)",
          "legendFormat": "Active DEXs",
          "refId": "B"
        },
        {
          "expr": "sum(multi_geyser_stream_messages_total)",
          "legendFormat": "Total Messages",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 10}
            ]
          },
          "unit": "short",
          "decimals": 1
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Raw Geyser stream flow rates by DEX before any smart filtering, throttling, or competition detection. Shows pure blockchain data pipeline health.",
  "gnetId": null,
  "version": 1
}