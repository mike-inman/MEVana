# =============================================================================
# SOLANA ARBITRAGE PLATFORM - ENVIRONMENT VARIABLES
# =============================================================================

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Solana Network (mainnet-beta, testnet, devnet)
SOLANA_NETWORK=mainnet-beta

# Shyft gRPC Configuration
SHYFT_GRPC_ENDPOINT=https://grpc.shyft.to
SHYFT_GRPC_TOKEN=your_shyft_token_here

# Raydium Stream Service Configuration
ENDPOINT=https://grpc.ny.shyft.to
X_TOKEN=your_shyft_token_here

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Redis Channels
REDIS_CHANNEL_ORCA_SWAPS=orca.swaps
REDIS_CHANNEL_RAYDIUM_SWAPS=raydium.swaps
REDIS_CHANNEL_JUPITER_SWAPS=jupiter.swaps

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================

# Kafka Brokers
KAFKA_BROKERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka Topics
KAFKA_TOPIC_SWAPS=swaps
KAFKA_TOPIC_ARBITRAGE=arbitrage

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# Stream Services
STREAM_ORCA_ENABLED=true
STREAM_RAYDIUM_ENABLED=true
STREAM_JUPITER_ENABLED=false

# Processing Services
SWAP_INGEST_ENABLED=true
PATHFINDER_ENABLED=true

# =============================================================================
# ARBITRAGE DETECTION
# =============================================================================

# Minimum profit threshold (1.001 = 0.1% profit)
MIN_PROFIT_THRESHOLD=1.001

# Maximum path length for arbitrage detection
MAX_PATH_LENGTH=5

# Scan interval in seconds
SCAN_INTERVAL_SECONDS=1

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level (trace, debug, info, warn, error)
LOG_LEVEL=info

# Log Format (json, text)
LOG_FORMAT=text

# Enable structured logging
STRUCTURED_LOGGING=true

# =============================================================================
# MONITORING & METRICS
# =============================================================================

# Prometheus Metrics Port
METRICS_PORT=9090

# Health Check Interval
HEALTH_CHECK_INTERVAL=30s

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (for future use)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mev
POSTGRES_PASSWORD=mevpassword
POSTGRES_DB=mevdb

# Remote database replica (optional)
REMOTE_DATABASE_URL=postgresql://mev:mevpassword@your-remote-db:5433/mevdb
# Override for local host connection when syncing (defaults to exposed postgres container)
LOCAL_DATABASE_URL=postgresql://mev:mevpassword@localhost:5433/mevdb
# Comma/space separated list of tables to sync (defaults target config tables)
DB_SYNC_TABLES=vault_config,dex_program_registry,circuit_breaker_state,service_levels,smart_filter_config_history,parameter_performance_impact,smart_filter_performance_snapshots,venue_performance_history

# =============================================================================
# FLASH LOAN PROVIDER CONFIG
# =============================================================================

# Solend WSOL host fee receiver (devnet example shown; replace for mainnet)
SOLEND_WSOL_HOST_FEE_ACCOUNT=AJVS4MHtdmwnKAkKbuX7FUKVwhuEM1woVRVctS4Gi33S

# Jet Protocol reserve configuration (devnet placeholders – replace with live values)
JET_LENDING_MARKET=BYfyBLsY64fJ86BEXRCRxbDfVZHsZ2gVV5vLqb7nz6Go
JET_RESERVE=FrtYFxEUWZw9p3FLAZ9mNMh6WKEnXGAcZ5BbW1VFNJhQ
JET_RESERVE_LIQUIDITY_SUPPLY=7jG5NHYhstH1BZtnHKCk1W3MDXU5eQomWRK6nFPDsyTV
JET_FEE_RECEIVER=k7ifQV7CkU3S27Q8nQVzjQRBa2F7WBHNXo2HaJ1wfbX
# Optional override if the PDA derivation does not match
# JET_MARKET_AUTHORITY=

# =============================================================================
# TOKEN CONFIGURATION
# =============================================================================

# Default tokens for testing
DEFAULT_TOKEN_IN=SOL
DEFAULT_TOKEN_OUT=USDC

# Token Registry Path
TOKEN_REGISTRY_PATH=/app/token_registry.json

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Batch size for processing
BATCH_SIZE=50

# Connection pool size
CONNECTION_POOL_SIZE=10

# Timeout settings
REQUEST_TIMEOUT_SECONDS=30
CONNECTION_TIMEOUT_SECONDS=10

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Enable debug mode
DEBUG=false

# Enable verbose logging
VERBOSE=false

# Enable development features
DEV_MODE=false

# =============================================================================
# SECURITY
# =============================================================================

# API Keys (if needed)
API_KEY_ORCA=
API_KEY_RAYDIUM=
API_KEY_JUPITER=

# JWT Secret (for future auth)
JWT_SECRET=your_jwt_secret_here 
