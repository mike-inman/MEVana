[Unit]
Description=MEVana API Gateway Service
After=network-online.target postgres.service kafka.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=mevana
Group=mevana
WorkingDirectory=/opt/MEVana
ExecStart=/opt/MEVana/bin/api-server
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/mevana/common.env
EnvironmentFile=-/etc/mevana/api-service.env
AmbientCapabilities=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true
SystemCallFilter=@system-service @network-io @file-system @process
SystemCallFilter=~@keyring @mount @module
ReadWritePaths=/opt/MEVana
LimitNOFILE=65535
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
