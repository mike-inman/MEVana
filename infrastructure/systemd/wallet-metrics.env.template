# Wallet Metrics Exporter Configuration
# Copy to /etc/mevana/wallet-metrics.env on server and update values

# Wallet address to monitor (set this to your test wallet address)
WALLET_ADDRESS=YOUR_WALLET_ADDRESS_HERE

# Shyft API credentials
X_TOKEN=efff2d23-97ae-4c5f-8b8b-9a6265001189
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JITO_API_URL=https://jito-api.jito.wtf

# Metrics server configuration
WALLET_METRICS_PORT=9905

# Update interval in seconds (default: 5)
WALLET_UPDATE_INTERVAL_SECS=5

# Logging
RUST_LOG=info
