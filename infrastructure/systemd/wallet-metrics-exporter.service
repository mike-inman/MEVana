[Unit]
Description=MEVana Wallet Metrics Exporter
Documentation=https://github.com/yourusername/MEVana
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mevana
Group=mevana
WorkingDirectory=/opt/MEVana

# Environment configuration
EnvironmentFile=/etc/mevana/wallet-metrics.env

# Binary location
ExecStart=/opt/MEVana/target/release/wallet-metrics-exporter

# Restart policy
Restart=always
RestartSec=10s

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/MEVana/logs

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wallet-metrics-exporter

[Install]
WantedBy=multi-user.target
