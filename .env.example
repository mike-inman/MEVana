# Geyser Configuration

# MEVana local configuration template
#
# Copy this file to `.env` for local development. Never commit `.env`, keypairs,
# cookies, logs, or wallet files.

# Solana/Geyser provider configuration
GEYSER_ENDPOINT=https://grpc.example.invalid
X_TOKEN=replace-with-provider-token
SHYFT_API_KEY=replace-with-shyft-api-key
SHYFT_RPC_URL=https://rpc.example.invalid
SHYFT_GEYSER_URL=https://grpc.example.invalid
SHYFT_GEYSER_X_TOKEN=replace-with-geyser-token
SHYFT_JITO_URL=https://jito.example.invalid

# Optional price/metadata providers
HELIUS_API_KEY=replace-with-helius-api-key
SHYFT_META_BASE_URL=https://api.example.invalid
SHYFT_META_API_KEY=replace-with-metadata-api-key

# Local infrastructure
KAFKA_BROKER=localhost:29092
REDIS_URL=redis://localhost:6379
POSTGRES_USER=mev
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=mevdb
DATABASE_URL=postgresql://mev:replace-with-local-password@localhost:5433/mevdb

# Runtime safety defaults
ENABLE_LIVE_EXECUTION=false
DRY_RUN=true
SIMULATION_MODE=true
PAPER_TRADING=true

# Wallet/Jito paths must point outside the repository or to ignored local files.
WALLET_KEYPAIR_PATH=/path/to/local/wallet-keypair.json
WALLET_BACKUP_PATHS=
JITO_AUTH_KEYPAIR_PATH=/path/to/local/jito-keypair.json

# Service ports
METRICS_PORT=8088
API_PORT=8089
EXECUTOR_METRICS_PORT=9904
HEALTH_CHECK_PORT=9898
