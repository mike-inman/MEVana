{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccountRegistryData",
  "type": "object",
  "properties": {
    "flash_loans": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
            "type": "object",
            "required": ["reserve","liquidity_supply","fee_receiver","oracle","mint","decimals"],
            "properties": {
              "reserve": {"type": "string"},
              "liquidity_supply": {"type": "string"},
              "fee_receiver": {"type": "string"},
              "oracle": {"type": "string"},
              "mint": {"type": "string"},
              "decimals": {"type": "integer", "minimum": 0, "maximum": 18}
            }
        }
      }
    },
    "clmm_pools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["pool","token_a_vault","token_b_vault","tick_arrays","token_a_mint","token_b_mint"],
        "properties": {
          "pool": {"type":"string"},
          "token_a_vault": {"type":"string"},
          "token_b_vault": {"type":"string"},
          "oracle_or_observation": {"type":["string","null"]},
          "tick_arrays": {"type":"array","items":{"type":"string"},"minItems":1},
          "token_a_mint": {"type":"string"},
          "token_b_mint": {"type":"string"}
        }
      }
    },
    "orderbooks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["market","bids","asks","event_queue","base_vault","quote_vault"],
        "properties": {
          "market": {"type":"string"},
          "bids": {"type":"string"},
          "asks": {"type":"string"},
          "event_queue": {"type":"string"},
          "base_vault": {"type":"string"},
          "quote_vault": {"type":"string"}
        }
      }
    },
    "oracles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["price"],
        "properties": {
          "price": {"type":"string"},
          "price_decimals": {"type":"integer","minimum":0,"maximum":18},
          "confidence_limit_bps": {"type":"integer","minimum":0,"maximum":10000}
        }
      }
    },
    "jito": {
      "type": "object",
      "properties": {
        "tip_account": {"type":["string","null"]}
      },
      "required": ["tip_account"],
      "additionalProperties": false
    }
  },
  "required": ["flash_loans","clmm_pools","orderbooks","oracles","jito"],
  "additionalProperties": false
}
