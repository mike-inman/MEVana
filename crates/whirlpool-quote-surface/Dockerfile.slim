FROM rust:1.89-slim as builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev build-essential cmake && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY crates/whirlpool-core /usr/src/app/crates/whirlpool-core
COPY crates/whirlpool-quote-surface /usr/src/app/crates/whirlpool-quote-surface

RUN cargo build --release --manifest-path crates/whirlpool-quote-surface/Cargo.toml

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /usr/src/app/crates/whirlpool-quote-surface/target/release/whirlpool-quote-surface /app/whirlpool-quote-surface
ENV RUST_LOG=info
CMD ["./whirlpool-quote-surface"]


