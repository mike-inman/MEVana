program_name: whirlpool
program_id: "whirLbMiicVdio4qvUfM5KAg6Ct8VwpYzGff3uctyCc"  # mainnet Whirlpool program id
swap_instructions:
  - name: "swap"
    kind: "CLMM"
    pool_account_roles: ["whirlpool", "pool"]
    user_authority_roles: ["tokenAuthority", "authority", "owner"]
    token_accounts_roles_in:  ["tokenOwnerAccountA", "tokenOwnerAccountB", "token_owner_account_a", "token_owner_account_b"]
    token_accounts_roles_out: ["tokenOwnerAccountB", "tokenOwnerAccountA", "token_owner_account_b", "token_owner_account_a"]
    clmm_state_account: "whirlpool"

  - name: "swapV2"
    kind: "CLMM"
    pool_account_roles: ["whirlpool"]
    user_authority_roles: ["tokenAuthority"]
    token_accounts_roles_in:  ["tokenOwnerAccountA", "tokenOwnerAccountB"]
    token_accounts_roles_out: ["tokenOwnerAccountB", "tokenOwnerAccountA"]
    clmm_state_account: "whirlpool"

  - name: "twoHopSwap"
    kind: "CLMM"
    pool_account_roles: ["whirlpoolOne", "whirlpoolTwo"]
    user_authority_roles: ["tokenAuthority"]
    token_accounts_roles_in:  ["tokenOwnerAccountOneA", "tokenOwnerAccountTwoA"]
    token_accounts_roles_out: ["tokenOwnerAccountOneB", "tokenOwnerAccountTwoB"]

  - name: "twoHopSwapV2"
    kind: "CLMM"
    pool_account_roles: ["whirlpoolOne", "whirlpoolTwo"]
    user_authority_roles: ["tokenAuthority"]
    token_accounts_roles_in:  ["tokenOwnerAccountInput"]
    token_accounts_roles_out: ["tokenOwnerAccountOutput"]
