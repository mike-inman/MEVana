# High-Frequency Arbitrage Configuration
# Target: 3 trades per minute at $0.75-$1.05/minute profit

# Ultra-aggressive arbitrage settings
ARB_MIN_PROFIT_BPS=8             # 0.08% minimum profit (very aggressive)
ARB_MAX_SLIPPAGE_BPS=30          # 0.30% max slippage (tight control)
ARB_DEPTH_IMPACT_BPS=15          # Allow some depth impact for more opportunities

# Adaptive sizing for high frequency
ARB_SIZING_MODE=adaptive         # Use adaptive sizing
ARB_ADAPT_MIN_MULTIPLIER=0.25    # Scale down to 25% for frequent small trades
ARB_ADAPT_MAX_MULTIPLIER=0.85    # Scale up to 85% for high-confidence trades
ARB_ADAPT_HISTORY=128            # Smaller history for faster adaptation
ARB_ADAPT_MIN_SIZE_LAMPORTS=250000000  # 0.25 SOL minimum trade size

# Jupiter high-frequency settings
JUPITER_SCAN_INTERVAL_MS=250     # Scan every 250ms (ultra-fast)
JUPITER_MIN_PROFIT_BPS=12        # 0.12% minimum for Jupiter routes
JUPITER_MAX_PRICE_IMPACT=1.0     # 1% max price impact
JUPITER_MAX_SLIPPAGE_BPS=50      # 0.50% max slippage
JUPITER_MAX_HOPS=4               # Allow up to 4 hops for complex arbitrage

# Performance optimization
HOTPATH_LOG=true
RUST_LOG=info

# Multi-venue configuration (all enabled for maximum opportunities)
ENABLE_ORCA=true
ENABLE_RAYDIUM=true
ENABLE_METEORA=true
ENABLE_PHOENIX=true
ENABLE_JUPITER=true

# Fringe trading mode for expanded opportunities
FRINGE_TRADING_MODE=aggressive    # Options: conservative, extended, aggressive, fringe_only

# Risk management for fringe tokens
FRINGE_MAX_POSITION_SOL=2.0       # Max 2 SOL per fringe token trade
FRINGE_MIN_LIQUIDITY_SOL=10.0     # Minimum pool liquidity for fringe tokens
FRINGE_VOLATILITY_THRESHOLD=0.15  # 15% max volatility for safety

# Advanced DEX integration
ENABLE_OPENBOOK=true              # OpenBook (Serum successor)
ENABLE_LIFINITY=true              # Lifinity proactive market maker
ENABLE_CROPPER=true               # Cropper Finance
ENABLE_SABER=true                 # Saber (stable swaps)

# Infrastructure
KAFKA_BROKER=localhost:29092