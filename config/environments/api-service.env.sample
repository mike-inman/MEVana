# MEVana API service configuration.
# Copy to /etc/mevana/api-service.env and adjust for your environment.

# HTTP binding for the REST API that powers the MEVana UI gateway.
PORT=8092

# Enable the consolidated gateway (REST + WebSocket fan-out) and listen on 8095.
MEVANA_GATEWAY_ENABLE=true
MEVANA_WEBSOCKET_GATEWAY_PORT=8095

# Kafka topics the gateway will mirror to downstream WebSocket/SSE clients.
GATEWAY_PRICES_TOPIC=prices.latest
GATEWAY_SWAPS_TOPIC=orca-swaps.parsed
GATEWAY_SWAPS_V2_TOPIC=orca-swaps.parsed.v2
GATEWAY_OPPORTUNITIES_TOPIC=alerts.arbitrage.opportunities
GATEWAY_EXECUTION_RESULTS_TOPIC=execution.results.v1
# Optional overrides if bundles/fills are published on distinct topics
# GATEWAY_BUNDLES_TOPIC=execution.results.v1
# GATEWAY_FILLS_TOPIC=execution.results.v1

# Optional: tighten default logging or expose internal diagnostics endpoints.
# RUST_LOG=info
# API_JWT_SECRET=change-me
# API_ALLOW_HOST_INSPECTION=false

# The following values are inherited from /etc/mevana/common.env when present:
#   DATABASE_URL     -> Postgres used for API persistence
#   KAFKA_BROKER     -> Kafka bootstrap string for consumer groups
#   REDIS_URL        -> Gateway cache / rate limiter
#   MEVANA_GATEWAY_ENABLE -> keep in sync with UI configuration
#   FLASH_LOAN_PROVIDERS_CONFIG -> shared execution config (read-only)
