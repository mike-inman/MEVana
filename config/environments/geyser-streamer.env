# MEVana Geyser Streaming Configuration
# Combines the best of dex-stream-universal and searcher-dev configurations

# ===== GEYSER CONNECTION =====
# Primary Geyser endpoint (from dex-stream-universal)
ENDPOINT=https://grpc.ny.shyft.to
# Authentication token
X_TOKEN=efff2d23-97ae-4c5f-8b8b-9a6265001189

# ===== DEX PROGRAM MONITORING =====
# Core DEX programs to monitor for transactions
PROGRAM_IDS=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8,CAMMCzo5YL8w4VFF8KVHrK22GGUsp5VTaW7grrKgrWqGnT,LBUZKhRxPF3XUpBCjp4YzTKgLccjZhTSDM9YuVaPwxo,whirLbMiicVdio4qvUfM5KAg6Ct8VwpYzGff3uctyCc,srmqPvymJeFKQ4zGQed1GFppgkRHL9kaELCbyksJtPX,7WduLbRfYhTJktjLw5K2UqKGavXrGtAwxedvUNW4h4Ez

# ===== ACCOUNT POOL MONITORING =====
# Specific pool accounts to monitor for state changes
# Add your target pool addresses here for real-time state updates
ACCOUNT_POOLS=

# ===== ARBITRAGE CONFIGURATION =====
# Minimum spread required for arbitrage opportunities (basis points)
MIN_SPREAD_BPS=5
# Enable arbitrage detection
ENABLE_ARBITRAGE=true
# Maximum gas cost (lamports)
MAX_GAS_LAMPORTS=50000

# ===== SERVICE CONFIGURATION =====
# Health check port
HEALTH_PORT=8080
# Log level
RUST_LOG=info
# Service bind address
BIND_ADDRESS=0.0.0.0

# ===== KAFKA INTEGRATION (Optional) =====
# If you want to stream to Kafka like dex-stream-universal
KAFKA_BROKER=
KAFKA_TOPIC=dex-transactions

# ===== DATABASE INTEGRATION (Optional) =====
# PostgreSQL for transaction logging
DATABASE_URL=

# ===== DEX PROGRAM MAPPING =====
# For reference - program ID to DEX name mapping
# 675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8 = Raydium CPMM
# CAMMCzo5YL8w4VFF8KVHrK22GGUsp5VTaW7grrKgrWqGnT = Raydium CLMM
# LBUZKhRxPF3XUpBCjp4YzTKgLccjZhTSDM9YuVaPwxo = Meteora DLMM
# whirLbMiicVdio4qvUfM5KAg6Ct8VwpYzGff3uctyCc = Orca Whirlpool
# srmqPvymJeFKQ4zGQed1GFppgkRHL9kaELCbyksJtPX = OpenBook
# 7WduLbRfYhTJktjLw5K2UqKGavXrGtAwxedvUNW4h4Ez = GooseFX
# JUP4Fb2cqiRUcaTHdrPC8h2gNsA2ETXiPDD33WcGuJB = Jupiter V6
# JUP6LkbZbafMNUBhDSDueet2ApgUKPKodDhqWFLVvZpg = Jupiter Swap

# ===== EXAMPLE POOL ADDRESSES =====
# Uncomment and add your target pools to ACCOUNT_POOLS above
# SOL/USDC Raydium CPMM: 58oQChx4yWmvKdwLLZzBi4ChoCc2fqCUWBkwMihLYQo2
# SOL/USDC Meteora DLMM: [add your target pools]
# SOL/USDC Orca Whirlpool: [add your target pools]

# ===== MONITORING =====
# Enable Prometheus metrics
ENABLE_METRICS=true
# Metrics endpoint
METRICS_PORT=9090
