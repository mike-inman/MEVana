# MEVana discovery service configuration.
# Copy to /etc/mevana/discovery.env and revise topic names as needed.

# Kafka topic that receives unclassified program messages.
UNKNOWN_PROGRAMS_TOPIC=unknown-programs

# Metrics port exposed by the discovery HTTP server.
DISCOVERY_METRICS_PORT=9102

# Optional Redis cache used for throttling duplicate program IDs.
REDIS_URL=redis://127.0.0.1:6380/0
