# Shared environment variables for MEVana host deployments.
# Copy to /etc/mevana/common.env and fill with production values.

# PostgreSQL connection string used by hotpath, normalizer, discovery, and executor.
DATABASE_URL=postgresql://mev:mevpassword@localhost:5433/mevdb

# Kafka bootstrap address shared by services.
KAFKA_BROKER=localhost:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Redis endpoint used by hotpath and normalizer helpers.
REDIS_URL=redis://127.0.0.1:6380/0

# Path to the deployed flash loan provider configuration JSON.
FLASH_LOAN_PROVIDERS_CONFIG=/opt/MEVana/config/flash_loan_providers.mainnet.json

# Path to the executor wallet keypair (seed this file before enabling executor).
WALLET_KEYPAIR_PATH=/opt/MEVana/keys/id.json

# Default logging level for all services (override per-service as needed).
RUST_LOG=info

# Disable live execution by default; flip in service-specific env when ready.
ENABLE_LIVE_EXECUTION=false

# Optional: configure admin API authentication via Clerk JWTs for Grafana control panels.
# CLERK_JWKS_URL=https://clerk.example.com/.well-known/jwks.json
# CLERK_ISSUER=https://clerk.example.com
# CLERK_ALLOWED_AUDIENCES=grafana-control-panel
# CLERK_ALLOWED_ROLES=ops-admin
# CLERK_AUTHORIZED_PARTY=grafana
# CLERK_JWKS_CACHE_SECS=300
