# MEVana executor service configuration.
# Copy to /etc/mevana/executor.env and customise per environment.

# Solana Geyser endpoint and auth token (falls back to ENDPOINT/X_TOKEN if unset).
GEYSER_ENDPOINT=https://grpc.ny.shyft.to
GEYSER_X_TOKEN=replace-with-shyft-token

# Execution safety toggles (keep dry run enabled until live testing is ready).
EXECUTION_DRY_RUN=true
EXECUTION_ALLOW_LIVE=false

# Metrics port exposed by the executor HTTP server.
METRICS_PORT=9904
HEALTH_CHECK_PORT=9898

# Allow missing Shyft credentials when testing locally.
ALLOW_EMPTY_SHYFT_API=1

# Optional account registry overrides.
ACCOUNT_REGISTRY_PATH=/opt/MEVana/config/account_registry.json
ACCOUNT_REGISTRY_STRICT=false

# Flash loan provider config (shared default comes from common.env).
# FLASH_LOAN_PROVIDERS_CONFIG=/opt/MEVana/config/flash_loan_providers.mainnet.json

# Optional admin API token for authenticated endpoints.
ADMIN_API_TOKEN=

# Human-friendly wallet labels for Prometheus/Grafana (path=label pairs separated by commas).
# Example: WALLET_LABELS=/opt/MEVana/keys/id.json=prod,~/.config/solana/dev-id.json=dev
WALLET_LABELS=/opt/MEVana/keys/id.json=prod

# Shyft metadata API for token enrichment (optional but recommended).
SHYFT_API_KEY=
SHYFT_META_BASE_URL=https://api.shyft.to

# Audit log destination (ensure the directory is writable by the mevana user).
AUDIT_LOG_PATH=/opt/MEVana/logs/executor_audit.log
