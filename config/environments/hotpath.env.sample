# MEVana hotpath arbitrage engine service-specific configuration.
# Copy to /etc/mevana/hotpath.env and replace placeholder values.

# Solana RPC / Geyser endpoint and authentication token.
GEYSER_ENDPOINT=https://grpc.ny.shyft.to
X_TOKEN=replace-with-shyft-token
# Multi-endpoint mode is experimental; leave disabled unless an ADR says otherwise.
MULTI_ENDPOINT_MODE=false

# Toggle simulation/paper trading controls (override the shared defaults only if needed).
# PAPER_TRADING=false
# DRY_RUN=false
# SIMULATION_MODE=false

# Metrics port exposed by the binary (readiness endpoint binds METRICS_PORT+1).
METRICS_PORT=8088

# Optional overrides for execution heuristics.
MIN_PROFIT_THRESHOLD=1.001
MAX_TRADES_PER_MINUTE=120

# Persisted property store path (must be writable by the mevana user).
PROPERTY_STORE_PERSISTENCE_PATH=/opt/MEVana/state/property_store.json

# Event bus reporter configuration (JSON string).
# Enables Kafka publishing so Grafana/UI can consume opportunities from alerts.arbitrage.opportunities.
EVENT_BUS_CONFIG='{"enable_file_logging":false,"enable_kafka":true,"kafka_broker":"localhost:29092","kafka_topic":"alerts.arbitrage.opportunities","enable_api_logging":false,"enable_redis":false,"batch_size":100,"flush_interval_ms":100,"sampling_rate":1.0}'

# Location for IDL registry assets loaded by the normalizer tooling.
IDL_REGISTRY_DIR=/opt/MEVana/idl

# Feature flags for venue integrations (uncomment as needed).
# ENABLE_JUPITER=true
# ENABLE_RAYDIUM=true
# ENABLE_ORCA=true

# Authentication token for the config API (optional).
API_AUTH_TOKEN=
