# MEVana Price Aggregator configuration.
# Consumes parsed swap events and publishes rolling prices to prices.latest.

# Kafka broker to connect to.
KAFKA_BROKER=localhost:29092

# Input topic for parsed swaps (Whirlpool v2 by default).
INPUT_TOPIC=orca-swaps.parsed.v2

# Output topic for aggregated prices.
OUTPUT_TOPIC=prices.latest

# Consumer group id.
GROUP_ID=price-aggregator

# Sliding window hint in seconds (appended to published snapshot).
WINDOW_SECS=5

# Ignore swaps with amount_in less than this threshold to avoid noisy prices.
MIN_AMOUNT_THRESHOLD=1.0
