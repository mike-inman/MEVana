# MEVana normalizer service configuration.
# Copy to /etc/mevana/normalizer.env and adjust for the target environment.

# Kafka topics consumed and produced by the service.
IN_TOPIC=dex-transactions
OUT_TOPIC=orca-swaps.parsed.v2
NORMALIZED_SWAPS_TOPIC=normalized-swaps.v1
GROUP_ID=normalizer-service

# Metrics port exposed by the normalizer HTTP server.
METRICS_PORT=9901

# Directory containing generated IDLs for decoding instructions.
IDL_REGISTRY_DIR=/opt/MEVana/idl

# Optional Redis cache for helper binaries.
REDIS_URL=redis://127.0.0.1:6380/0
