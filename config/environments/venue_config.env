# Venue configuration for MEVana arbitrage engine
# This file provides default environment variables for venue-specific settings

# Jupiter Integration
JUPITER_API_URL=https://quote-api.jup.ag/v6
JUPITER_MAX_HOPS=3
JUPITER_MIN_PROFIT_BPS=50
JUPITER_MAX_PRICE_IMPACT=3.0
JUPITER_SCAN_INTERVAL_MS=5000
JUPITER_PAPER_TRADING=false

# Edge Processing
EDGE_DELTA_TOPIC=edge.delta.v1
EDGE_KAFKA_DEBUG=false

# Synthetic edges (disabled in production)
ALLOW_SYNTH=0
EDGE_SYNTH=0

# WebSocket configuration
DISABLE_WS=0