# MEVana Development Environment Configuration

# Environment Identification
DEPLOYMENT_TARGET=development
ENVIRONMENT=development

# Server Configuration (Local)
SERVER_IP=localhost
SERVER_USER=local
DEPLOYMENT_PATH=/Users/michaelinman/Repos/MEVana

# Application Configuration
DATABASE_URL=postgresql://mev:mevpassword@localhost:5433/mevdb
GEYSER_ENDPOINT=https://grpc.ny.shyft.to
X_TOKEN=efff2d23-97ae-4c5f-8b8b-9a6265001189
KAFKA_BROKER=localhost:29092
METRICS_PORT=8088
MONITORING_PORT=8090
API_PORT=8080
RUST_LOG=debug
PAPER_TRADING=true
WALLET_KEYPAIR_PATH=/Users/michaelinman/Repos/MEVana/infrastructure/keys/id.json
JITO_AUTH_KEYPAIR_PATH=/Users/michaelinman/Repos/MEVana/infrastructure/keys/jito-keypair.json

# Infrastructure Configuration
PROMETHEUS_CONFIG=prometheus.yml
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASS=admin123

# Database Configuration
POSTGRES_USER=mev
POSTGRES_PASSWORD=mevpassword
POSTGRES_DB=mevdb
POSTGRES_PORT=5433

# Build Configuration
RUSTFLAGS="--cap-lints warn"
CARGO_BUILD_JOBS=8

# Health Check Endpoints
HEALTH_CHECK_URLS=(
    "http://localhost:8088/metrics"
    "http://localhost:9090/-/healthy"
    "http://localhost:3000/api/health"
)

# Required Services for Verification
REQUIRED_SERVICES=(
    "postgresql"
    "redis"
    "kafka"
    "prometheus"
    "grafana"
    "hotpath_arb_engine"
)

# Port Conflict Check
CRITICAL_PORTS=(8088 9090 3000 5433 6379 9092)
